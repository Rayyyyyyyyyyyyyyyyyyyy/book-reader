---
// Phase A prototype: three real books through the full shelf → stage → shelf chain.
// Removed once the shelf is wired into the home page (Phase B).
import Base from "../../layouts/Base.astro";
import ImmersiveShelf from "../../components/shelf/ImmersiveShelf";
import { CATEGORY_EN } from "../../data/categories";
import { getBooksSorted, entryToMeta } from "../../lib/books";
import { coverUrl } from "../../lib/covers";

const picks = [1, 4, 60];
const entries = (await getBooksSorted()).filter((e) => picks.includes(e.data.rank));
const books = await Promise.all(entries.map(async (e) => entryToMeta(e, await coverUrl(e.data.cover))));
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const sections = [{ key: "psych", zh: "原型 · 三本書", en: CATEGORY_EN.psych, books }];
---

<Base title="書架原型 · 百冊">
  <main style="max-width: 1200px; margin: 0 auto; padding: 64px 28px;">
    <ImmersiveShelf client:load sections={sections} base={base} />
  </main>
</Base>
