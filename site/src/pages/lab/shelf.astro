---
// Prototype: every book on the shelf by category (no search/filters yet).
// Removed once the shelf is wired into the home page (Phase B).
import Base from "../../layouts/Base.astro";
import ImmersiveShelf from "../../components/shelf/ImmersiveShelf";
import { CATEGORIES } from "../../data/categories";
import { getBooksSorted, entryToMeta } from "../../lib/books";
import { coverColor, coverUrl } from "../../lib/covers";

const books = await Promise.all(
  (await getBooksSorted()).map(async (e) => entryToMeta(e, await coverUrl(e.data.cover), await coverColor(e.data.cover))),
);
const base = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + "/";
const sections = CATEGORIES.map((c) => ({ key: c.key, zh: c.zh, en: c.en, books: books.filter((b) => b.cat === c.key) }));
---

<Base title="書架原型 · 百冊">
  <main style="max-width: 1200px; margin: 0 auto; padding: 64px 28px;">
    <ImmersiveShelf client:load sections={sections} base={base} />
  </main>
</Base>
